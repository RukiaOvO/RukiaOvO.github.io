# Canonical production URL; never use the Preview URL here.
SITE_URL=http://localhost:3000
# On Vercel, omit SITE_URL to use VERCEL_PROJECT_PRODUCTION_URL automatically.
# Public GitHub activity and RSS work without private API credentials.
# Optional: increases GitHub API quota. Server-only; never NEXT_PUBLIC_*.
# GITHUB_TOKEN=
# Optional shared rate limiting.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel Web Analytics visitor count (server-only; never NEXT_PUBLIC_*).
# VERCEL_ANALYTICS_TOKEN=
# Vercel injects VERCEL_PROJECT_ID and VERCEL_ORG_ID in deployed functions.
# Override only if needed:
# VERCEL_ANALYTICS_PROJECT_ID=
# VERCEL_ANALYTICS_TEAM_ID=
# Date Web Analytics collection started; counts cannot include earlier visits.
# VERCEL_ANALYTICS_SINCE=2026-11-06
# Force non-indexable temporary previews, including metadata, robots and sitemap.
# SITE_NOINDEX=true
# Protects the daily Vercel market-cache refresh cron. Configure the same random value in Vercel Production.
# CRON_SECRET=
# GitHub OAuth for the Markdown editor at /admin/ (requires a registered GitHub OAuth App).
# Set both URLs to the same HTTPS production origin. Callback URL must include provider=github.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# CMS_OAUTH_BASE_URL=https://rukiaovo-homepage.vercel.app
# CMS_OAUTH_REDIRECT_URI=https://rukiaovo-homepage.vercel.app/api/auth/callback?provider=github
# Optional Steam Worker endpoints. Set these if the default workers.dev URLs have changed.
# STEAM_STATUS_URL=https://your-worker.example/steam
# STEAM_GAMES_URL=https://your-worker.example/steam/games
# Recommended: use Steam Web API directly through the server proxy. Keep the API key server-only.
# STEAM_API_KEY=
# STEAM_ID=76561198417009401
